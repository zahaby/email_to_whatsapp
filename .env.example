# --- Mailbox to watch (IMAP over SSL) ---
# Gmail: IMAP_HOST=imap.gmail.com and an App Password (Google Account > Security > App passwords)
# Outlook/Office365: outlook.office365.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
POLL_SECONDS=30

# Optional: only forward mail whose From address contains one of these (comma separated)
# SENDER_FILTER=boss@company.com,@school.edu

# --- WhatsApp recipients (international format, comma separated) ---
WHATSAPP_RECIPIENTS=+201000000001,+201000000002

# --- WhatsApp provider: twilio | meta | callmebot ---
WHATSAPP_PROVIDER=twilio

# Twilio (https://console.twilio.com > Messaging > Try it out > Send a WhatsApp message)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API
# META_ACCESS_TOKEN=EAAG...
# META_PHONE_NUMBER_ID=123456789012345
# META_TEMPLATE_NAME=email_alert     # optional, approved template with one {{1}} body param
# META_TEMPLATE_LANG=en_US

# CallMeBot (free, personal use; each recipient gets their own key)
# CALLMEBOT_API_KEYS=+201000000001:123456,+201000000002:654321
