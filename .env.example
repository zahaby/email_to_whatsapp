# --- Mailbox to watch (IMAP over SSL) ---
# Gmail: IMAP_HOST=imap.gmail.com and an App Password (Google Account > Security > App passwords)
# Outlook/Office365: outlook.office365.com
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
POLL_SECONDS=30

# Optional: only forward mail whose From address contains one of these (comma separated)
# SENDER_FILTER=boss@company.com,@school.edu

# --- WhatsApp recipients (international format, comma separated) ---
WHATSAPP_RECIPIENTS=+201000000001,+201000000002

# --- WhatsApp provider: waha | callmebot | twilio | meta ---
WHATSAPP_PROVIDER=waha

# WAHA: self-hosted WhatsApp Web bridge (see docker-compose.yml)
# Pick long random values, e.g. `openssl rand -hex 24`.
WAHA_API_KEY=change-me-long-random-string
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-too
# WAHA_URL=http://localhost:3000   # set automatically when using docker compose
# WAHA_SESSION=default

# CallMeBot (alternative)
# CALLMEBOT_API_KEYS=+201000000001:123456,+201000000002:654321

# Twilio (alternative)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (alternative)
# META_ACCESS_TOKEN=EAAG...
# META_PHONE_NUMBER_ID=123456789012345
# META_TEMPLATE_NAME=email_alert     # optional, approved template with one {{1}} body param
# META_TEMPLATE_LANG=en_US
